# 开发：SQLite（零配置）
DATABASE_URL=sqlite+aiosqlite:///./toto.db

# 生产：PostgreSQL（先 docker compose up -d）
# DATABASE_URL=postgresql+asyncpg://toto:toto@localhost:5432/toto

# 爬虫
SCRAPE_DELAY_SECONDS=5.0
SCRAPE_USER_AGENT=TotoAnalyzer/0.1 (personal-project)
SCRAPE_MAX_RETRIES=3

# API
API_CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# JWT (P3 阶段才用)
JWT_SECRET=change-me-please-generate-with-openssl-rand-hex-32
