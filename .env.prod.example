# ============================================================
# 生产环境配置模板
# 用法: cp .env.prod.example .env.prod   然后填值
# 注意: .env.prod 已在 .gitignore，不要提交到仓库
# ============================================================

# --- 域名 ---
# 设置后 Caddy 会自动申请 Let's Encrypt 证书。务必先把 DNS A 记录指向 VPS。
# 没域名只想用 IP 测试：留默认或写 :80（无 HTTPS）。
DOMAIN=your-domain.com

# --- 数据库 ---
# SQLite (默认，零配置)。Docker 内挂到 /data/toto.db，对应宿主机 ./data/toto.db
DATABASE_URL=sqlite+aiosqlite:////data/toto.db
# 切到 Postgres? 自己起 Postgres 容器后改成：
# DATABASE_URL=postgresql+asyncpg://toto:STRONG_PASSWORD@postgres:5432/toto

# --- API CORS ---
# 生产应只允许自己的域名（前端跟后端同域时其实可以不设，但更安全是显式）
API_CORS_ORIGINS=["https://your-domain.com"]

# --- 爬虫 ---
SCRAPE_DELAY_SECONDS=5.0
SCRAPE_USER_AGENT=TotoAnalyzer/0.1 (personal-project; +https://your-domain.com)
SCRAPE_MAX_RETRIES=3

# --- JWT (鉴权 P3 阶段才用，提前生成好) ---
# 生成命令: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_openssl_rand_hex_32_OUTPUT
